{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm install)",
      "Bash(curl:*)",
      "Bash(curl.exe:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./backend/secrets.env)",
      "Read(./**/secrets.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./backend/secrets.env)"
    ]
  }
}
