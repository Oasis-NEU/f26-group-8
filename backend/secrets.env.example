# Template for backend/secrets.env. COPY this file (don't rename it) to secrets.env in the
# same folder, then put your real values after the = signs. No quotes, no spaces around the =.
#
# secrets.env is gitignored, so your real keys never get committed.
# This .example file has no real values, so it's safe to commit and share.
# Never paste the real values into chat, GitHub, or the frontend.


# --- Supabase (needed for everything) ---
# SUPABASE_URL: https://<project-id>.supabase.co. The project id is the part after
# /project/ in your Supabase dashboard link.
# SUPABASE_SECRET_KEY: dashboard -> Project Settings -> API Keys -> Secret keys
# (starts with sb_secret_). NOT the publishable key. It skips RLS, so it only ever lives here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=


# --- old password login (/auth/signup, /auth/login) ---
# any long random string. make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Goes away in plans.md Task S5.
JWT_KEY=


# --- job importer (plans.md JB2). Not used yet: fill these in when we add USAJOBS and Adzuna ---
# USAJOBS: free key from developer.usajobs.gov (Request API Key).
# USAJOBS_EMAIL must be the same email you signed up with (they check it).
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Adzuna: free key from developer.adzuna.com (Register). You get an app id AND an app key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
